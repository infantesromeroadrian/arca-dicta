# Reference only: launch does not source files. Set these in the caller's
# environment. Paths must be absolute and may contain spaces.
# No interpreter, dependency, credential or model is installed automatically.
ARCA_DICTA_PYTHON="/path/to/daemon-runtime/bin/python"
ARCA_DICTA_WORKER_PYTHON="/path/to/preview-runtime/bin/python"
ARCA_DICTA_MODEL_DIR="/path/to/external/faster-whisper-small"
ARCA_DICTA_UPSTREAM_LIB="/usr/lib/hyprwhspr/lib"
ARCA_DICTA_UPSTREAM_BIN="/usr/bin/hyprwhspr"
